# ============================================================
# HH GOA Voice RAG — configuration
# Copy to .env and adjust. Every value is optional; the app
# runs fully offline on the curated corpus without any keys.
# ============================================================

# --- dataset ---------------------------------------------------------------
# 0 (default): curated MSMARCO-XI mirror corpus (instant, offline).
# 1: build the index from the real ai4bharat/MSMARCO-XI stream (network + time heavy).
# HHGOA_USE_REAL=1
# HHGOA_DATASET_ID=ai4bharat/MSMARCO-XI
# HHGOA_DATASET_CONFIG=default
# HHGOA_DATASET_SPLIT=train
# HHGOA_DATASET_LANGUAGE=hin
# HHGOA_SAMPLE_ROWS=700
# HHGOA_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- retrieval -------------------------------------------------------------
# HHGOA_TOP_K=6
# HHGOA_RERANK_TOP=4
# HHGOA_BM25_TOP=20
# HHGOA_DENSE_TOP=20
# HHGOA_MIN_SCORE=0.5
# HHGOA_CHUNK_SIZE=320
# HHGOA_CHUNK_OVERLAP=64

# --- STT -------------------------------------------------------------------
# sarvam | elevenlabs | groq
# HHGOA_STT_PROVIDER=sarvam
# SARVAM_API_KEY=
# HHGOA_SARVAM_MODEL=saaras:v3
# ELEVENLABS_API_KEY=
# HHGOA_ELEVENLABS_MODEL=scribe_v2

# --- LLM (generation) ------------------------------------------------------
# Uses the Groq OpenAI-compatible endpoint. Set GROQ_API_KEY to enable
# LLM answers; without a key the harness answers extractively.
# GROQ_API_KEY=
# HHGOA_LLM_BASE_URL=https://api.groq.com/openai/v1
# HHGOA_LLM_MODEL=openai/gpt-oss-20b
# HHGOA_LLM_MAX_TOKENS=240
# HHGOA_LLM_TEMPERATURE=0.2
# HHGOA_LLM_TIMEOUT=8.0

# --- app -------------------------------------------------------------------
# HHGOA_HOST=0.0.0.0
# HHGOA_PORT=8000